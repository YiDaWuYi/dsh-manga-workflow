{
  "name": "dsh-manga-workflow",
  "version": "1.16.0",
  "description": "漫画汉化工作流 / Manga translation workflow: auto box detection, local OCR (JA/KO/EN), AI translation, erase + Chinese embedding, failure report, sidebar workbench and desktop marker.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "dsh-plugin",
    "manga",
    "translation",
    "ocr",
    "inpainting",
    "lama",
    "furry",
    "漫画",
    "汉化",
    "嵌字",
    "翻译",
    "auto-detection",
    "failure-report",
    "workbench"
  ],
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YiDaWuYi/dsh-manga-workflow.git"
  },
  "homepage": "https://github.com/YiDaWuYi/dsh-manga-workflow",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./assets/icon-custom.png",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "scripts",
    "locale/*.json",
    "docs",
    "assets",
    "icon.svg",
    "CHANGELOG.md",
    "RELEASING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "icon": "./assets/icon-custom.png"
}
