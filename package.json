{
  "name": "dsh-manga-workflow",
  "version": "1.14.0",
  "description": "Manga translation workflow for DeepSeek Harness: local Japanese/Korean/English OCR, GPU de-text and Chinese embedding tools, a sidebar workbench with a web box marker, an auto-detection benchmark, and a transient readiness banner.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "dsh-plugin",
    "manga",
    "translation",
    "ocr",
    "inpainting",
    "lama",
    "furry"
  ],
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YiDaWuYi/dsh-manga-workflow.git"
  },
  "homepage": "https://github.com/YiDaWuYi/dsh-manga-workflow",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "scripts",
    "locale/*.json",
    "docs",
    "icon.svg",
    "CHANGELOG.md",
    "RELEASING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
